  "files": ["web", "runtime/src", "runtime/include", "runtime/examples", "runtime/.cargo", "runtime/third_party", "runtime/Cargo.toml", "runtime/Cargo.lock", "runtime/README.md", "runtime/LICENSE", "lab", "workshop", "kithmoot_vision", "scripts", "pyproject.toml", "art", "docs", "recipes", "LICENSE", "README.md"],
